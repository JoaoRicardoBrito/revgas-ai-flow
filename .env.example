# Copie para .env e preencha. NUNCA versione o .env.
# Minutos sem mensagem até a sessão expirar (abandono). Padrão: 30.
CONVERSATION_TTL_MINUTES=
# Preço por peso do botijão (a API da RevGás não tem preço). Ex.: P13:120,P20:180
# Vazio: preços de demonstração no modo mock; nenhum produto à venda no modo real.
PRODUCT_PRICES=
# Área de entrega (a API não tem). Bairros separados por vírgula e/ou raio em volta da loja.
# Tudo vazio: sem restrição.
COVERAGE_NEIGHBORHOODS=
COVERAGE_CENTER=
COVERAGE_RADIUS_KM=
# Horário do atendimento humano, ex.: 08:00-18:00. Vazio: sempre aberto.
BUSINESS_HOURS=
# Dias com atendimento (0 = domingo). Padrão: 1,2,3,4,5,6.
BUSINESS_DAYS=
# Padrão: America/Fortaleza.
BUSINESS_TIMEZONE=
# Cache de produtos e formas de pagamento, em segundos. Padrão: 120.
CATALOG_CACHE_SECONDS=
# A nota fiscal exige CPF de cliente novo? Padrão: false (na NFC-e é opcional).
CPF_REQUIRED=

REVGAS_API_BASE_URL=https://api.revgas.com/v1
REVGAS_API_KEY= 
REVGAS_USE_MOCK=true
# Obrigatório com REVGAS_USE_MOCK=false. ID da revenda em GET /establishments.
REVGAS_ESTABLISHMENT_ID=

GROQ_API_KEY=
# Vazio = openai/gpt-oss-20b. Sem GROQ_API_KEY, a conversa segue só com botões.
GROQ_MODEL=

# Postgres do Supabase (Connection string > URI). Vazio = PGlite em memória.
DATABASE_URL=

# Opcional: canal WhatsApp (Cloud API da Meta, número de teste)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
