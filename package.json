{
  "name": "revgas-ai-flow",
  "version": "0.1.0",
  "description": "Protótipo de um atendente com IA que recebe pedidos de gás por chat e cria a venda no sistema RevGás. Projeto de Extensão do iCEV (Engenharia de Software, 2026.2).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build && vite build web",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings src/ test/ web/src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:check && npm run test && npm run test:e2e",
    "test:contract:real": "REVGAS_CONTRACT_REAL=true vitest run src/revgas/http/http-revgas-client.real.spec.ts --testTimeout=30000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit generate && git diff --exit-code -- drizzle && test -z \"$(git ls-files --others --exclude-standard -- drizzle)\"",
    "test:llm:live": "GROQ_LIVE=true vitest run src/llm/groq/groq-llm-client.live.spec.ts --testTimeout=30000",
    "web:dev": "vite web",
    "demo": "npm run build && node dist/main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoaoRicardoBrito/revgas-ai-flow.git"
  },
  "bugs": {
    "url": "https://github.com/JoaoRicardoBrito/revgas-ai-flow/issues"
  },
  "homepage": "https://github.com/JoaoRicardoBrito/revgas-ai-flow#readme",
  "dependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@nestjs/common": "^12.6.3",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.17",
    "@nestjs/testing": "^12.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
